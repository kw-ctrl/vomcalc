{
  "buildCommand": "node scripts/build-config.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/courses",
      "destination": "/members/index.html"
    },
    {
      "source": "/members",
      "destination": "/members/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/logo.png"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
